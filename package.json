{
  "name": "flow",
  "version": "1.0.0",
  "private": true,
  "author": "Bruno Futema <bruno.futema@outlook.com>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build:web": "yarn workspace @flow/web build",
    "predeploy:web": "yarn workspace @flow/web predeploy",
    "deploy:web": "yarn workspace @flow/web deploy",
    "deploy:web:github-pages": "yarn predeploy:web && yarn deploy:web"
  },
  "devDependencies": {
    "turbo": "2.9.9"
  }
}
